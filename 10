#include <stdio.h>

float calcularTotal(float vendas[], int quantidade) {
    int i;
    float total = 0;

    for (i = 0; i < quantidade; i++) {
        total = total + vendas[i];
    }

    return total;
}

float calcularMedia(float total, int quantidade) {
    return total / quantidade;
}

int contarVendasAcimaDaMedia(float vendas[], float media, int quantidade) {
    int i, contador = 0;

    for (i = 0; i < quantidade; i++) {
        if (vendas[i] > media) {
            contador++;
        }
    }

    return contador;
}

int main() {
    float vendas[5], total, media;
    int i, acima;

    for (i = 0; i < 5; i++) {
        printf("Digite a venda do dia %d: ", i + 1);
        scanf("%f", &vendas[i]);
    }

    total = calcularTotal(vendas, 5);

    media = calcularMedia(total, 5);

    acima = contarVendasAcimaDaMedia(vendas, media, 5);

    printf("\nTotal vendido: %.2f\n", total);
    printf("Media diaria: %.2f\n", media);
    printf("Dias acima da media: %d\n", acima);

    return 0;
}
